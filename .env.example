# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL - will get from Railway)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/clinic_db

# Auth
JWT_SECRET=your_64_char_random_secret_here
JWT_REFRESH_SECRET=another_64_char_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp / SMS (Twilio - fill later)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Redis
REDIS_URL=redis://localhost:6379